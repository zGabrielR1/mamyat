# Keep the build context to what the image actually needs.
.git/
.gitignore
.venv/
__pycache__/
**/__pycache__/
*.pyc

# Cloudflare builds the frontend from source; exclude only local outputs
web/node_modules/
web/.next/
web/out/
web/.env*

# dependencies are installed inside their own stage from the lockfiles
**/node_modules/

# local secrets and runtime state never enter an image layer
.env
.env.*
!.env.example
data/runtime/
.tmp/

docs/
decisions/
.agents/
.codex/
.wrangler/
.npm-cache/
.playwright-mcp/
