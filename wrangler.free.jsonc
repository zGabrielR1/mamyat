{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mamyat",
  "main": "cloudflare/free-worker.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "web/out", "binding": "ASSETS", "run_worker_first": ["/api", "/api/*", "/produto/*", "/pedido/*", "/admin", "/admin/*", "/media", "/media/*"] },
  "observability": { "enabled": true },
  "vars": {
    "API_URL": "https://oiplbtukraykycifwccn.supabase.co/functions/v1/shop-api",
    "ADMIN_URL": "https://mamyat-admin.henriquealveslohrayne.workers.dev",
    "MEDIA_URL": "https://oiplbtukraykycifwccn.supabase.co/storage/v1/object/public/product-media"
  }
}
