{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mamyat",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "routes": [
    { "pattern": "mamyatelie.com", "custom_domain": true },
    { "pattern": "www.mamyatelie.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "containers": [{
    "class_name": "Shop", "image": "./Dockerfile.cloudflare",
    "instance_type": "basic", "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "SHOP", "class_name": "Shop" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shop"] }],
  "vars": { "APP_ENV": "production" }
}
