{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mamyat-admin",
  "main": "cloudflare/admin-worker.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "web/out", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "vars": {
    "API_URL": "https://oiplbtukraykycifwccn.supabase.co/functions/v1/shop-api",
    "MEDIA_URL": "https://oiplbtukraykycifwccn.supabase.co/storage/v1/object/public/product-media"
  }
}
