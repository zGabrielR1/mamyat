FROM node:22-bookworm-slim AS webbuild
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim AS authdeps
WORKDIR /auth
COPY auth-server/package.json auth-server/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM python:3.14-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 DATA_DIR=/data HOST=0.0.0.0 PORT=8080
WORKDIR /app
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY api/ ./api/
COPY foundry/ ./foundry/
COPY data/seed/ ./data/seed/
COPY supabase/ ./supabase/
COPY auth-server/*.mjs ./auth-server/
COPY --from=authdeps /auth/node_modules ./auth-server/node_modules
COPY --from=webbuild /web/.next/standalone/ ./web/
COPY --from=webbuild /web/.next/static/ ./web/.next/static/
COPY --from=webbuild /web/public/ ./web/public/
COPY scripts/container.py ./scripts/container.py
RUN groupadd -r mamyat && useradd -r -g mamyat mamyat \
    && mkdir -p /data && chown -R mamyat:mamyat /app /data
USER mamyat
EXPOSE 3000 8080
# Supervisor runs python3 -m api.server, Next standalone, auth-server/server.mjs.
CMD ["python3", "scripts/container.py"]
