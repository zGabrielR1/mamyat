# Mamy Ateliê — every setting the backend and the auth sidecar read.
#
# Copy to the gitignored file(s) named in the section header. The app also
# accepts a single `.env`; real environment variables always win over a file.
# Nothing here is required for a local demo: unset providers degrade to the
# console mailer, the no-op captcha, the demo Pix rail and the JSON store.

# --- .env: the host -------------------------------------------------------
# Where the process listens. Render injects PORT; bind 0.0.0.0 on a host.
HOST=127.0.0.1
PORT=8080
# Ticket data. On Render set /data (see render.yaml). Defaults to data/runtime.
DATA_DIR=
# Comma-separated origins allowed to call the API with CORS. Empty means "any
# Origin that arrives", which is fine behind the Vercel proxy.
CORS_ORIGINS=
# Canonical storefront origin used in emails (password reset, order links).
# Never derived from a request header.
PUBLIC_BASE_URL=https://mamyatelie.com
# Serve a built storefront from this directory when the API and site share a
# container. Leave empty on Render (Vercel serves the site).
WEB_DIR=
# Artificial delay before a failed login, in seconds.
LOGIN_DELAY=0.12

# --- .env: Supabase/Postgres (optional) -----------------------------------
# When set, every collection is a JSONB document in `mamyat_documents`.
# Normalised to postgresql+psycopg:// automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- .env: the admin panel ------------------------------------------------
ADMIN_USERNAME=admin
# 8+ characters. When blank, a `mamy-…` password is generated and written to
# data/runtime/admin_initial_password.txt (change it in the panel afterwards).
ADMIN_PASSWORD=

# --- .env: customer sessions ----------------------------------------------
# Optional signing key; blank derives one from BETTER_AUTH_SECRET, then from
# data/runtime/customer_session.key. Rotating this logs every customer out.
CUSTOMER_SESSION_SECRET=

# --- .env.resend: email ---------------------------------------------------
# Blank key = console mailer (messages are logged, never sent).
RESEND_API_KEY=
MAIL_FROM=Mamy Ateliê <oi@mamyatelie.com>
MAIL_FROM_NAME=Mamy Ateliê

# --- .env.turnstile: captcha ----------------------------------------------
# Blank secret = verifier disabled and the gate is a no-op. The site key is
# public; hostnames are the allowlist for the widget.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=mamyatelie.com,www.mamyatelie.com,localhost

# --- .env.asaas: Pix ------------------------------------------------------
# Blank key = DemoPayments, clearly labelled "demonstração" in the storefront.
ASAAS_API_KEY=
ASAAS_CUSTOMER_ID=
ASAAS_WEBHOOK_SECRET=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# --- .env.betterauth: social sign-in --------------------------------------
# The Python host proxies /api/betterauth/* to this loopback Node process.
BETTER_AUTH_URL=https://mamyatelie.com
BETTER_AUTH_TRUSTED_ORIGINS=https://mamyatelie.com,https://www.mamyatelie.com
BETTER_AUTH_APP_NAME=Mamy Ateliê
BETTER_AUTH_INTERNAL_PORT=3100
BETTER_AUTH_INTERNAL_URL=http://127.0.0.1:3100
# >= 32 high-entropy characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Shared secret that signs the social identity bridge. Set the same value here
# and in the auth sidecar.
BETTER_AUTH_BRIDGE_SECRET=
# Where the sidecar POSTs the signed identity. Defaults to 127.0.0.1:$PORT.
BETTER_AUTH_BRIDGE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 contents with newlines escaped as \n.
APPLE_PRIVATE_KEY=

# --- web/.env.local: the Next.js storefront -------------------------------
# Where /api/* is rewritten. Defaults to http://127.0.0.1:8080.
BACKEND_URL=http://127.0.0.1:8080
